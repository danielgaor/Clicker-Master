<Window x:Class="Juego_Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Juego_Clicker"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid VerticalAlignment="Center">
        <Button x:Name="btnJuego" Content="TÓCAME" HorizontalAlignment="Left" Height="48" Margin="68,311,0,0" VerticalAlignment="Top" Width="184" Click="Boton_Juego" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Background="#FF83E84F" BorderBrush="Black"/>
        <TextBlock x:Name="txtClics" Height="51" Margin="68,255,0,128" TextWrapping="Wrap" Text="LLEVAS: 0 CLICS" Width="184" FontFamily="Comic Sans MS" FontSize="20" HorizontalAlignment="Left" TextAlignment="Center"/>
        <Button x:Name="btnMejora" Content="MEJORAR" HorizontalAlignment="Center" Height="48" Margin="0,311,0,0" VerticalAlignment="Top" Width="184" Click="Boton_Mejora" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Background="#FFF6E548" BorderBrush="Black"/>
        <TextBlock x:Name="txtCoste" Height="51" Margin="0,255,0,128" TextWrapping="Wrap" Text="COSTE: 10 CLICS" Width="184" FontFamily="Comic Sans MS" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock x:Name="txtCadaVez" Height="51" Margin="0,199,0,184" TextWrapping="Wrap" Text="+1 CLIC CADA VEZ" Width="231" FontFamily="Comic Sans MS" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"/>
        <Button x:Name="btnJefe" Content="JEFE" HorizontalAlignment="Right" Height="48" Margin="0,311,68
                ,0" VerticalAlignment="Top" Width="184" Click="Boton_Jefe" FontFamily="Tw Cen MT Condensed Extra Bold" FontSize="20" Background="#FFF64848" BorderBrush="Black"/>
        <TextBlock x:Name="txtVidaJefe" Margin="0,0,39,148" TextWrapping="Wrap" Text="VIDA" Width="242" FontFamily="Comic Sans MS" FontSize="20" TextAlignment="Center" Visibility="Visible" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="txtTitulo" Margin="0,51,0,282" TextWrapping="Wrap" Text="CLICKER MASTER" Width="780" FontFamily="Showcard Gothic" FontSize="41" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FF000201" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="txtTitulo2" Margin="0,51,0,282" TextWrapping="Wrap" Text="CLICKER MASTER" Width="780" FontFamily="Showcard Gothic" FontSize="43" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#FF00FFBE" VerticalAlignment="Bottom"/>
        <Button x:Name="btnCreditos" Content="CRÉDITOS" Height="21" Margin="0,56,0,0" VerticalAlignment="Top" Width="92" Click="Boton_Creditos" FontFamily="Impact" FontSize="15" Background="#FFE6E6E6" BorderBrush="Black" HorizontalAlignment="Center"/>
        <TextBlock x:Name="txtCreditos" Margin="0,193,0,0" TextWrapping="Wrap" Text="JUEGO CREADO POR DANIEL GARCÍA ORTEGA" Width="708" FontFamily="Arial Black" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Top" Visibility="Hidden"/>
        <TextBlock x:Name="txtCreditos_Copiar" Margin="0,221,0,0" TextWrapping="Wrap" Text="LINKEDIN: DANIEL GARCÍA ORTEGA" Width="708" FontFamily="Arial Black" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Top" Visibility="Hidden"/>
        <TextBlock x:Name="txtCreditos_Copiar1" Margin="0,249,0,0" TextWrapping="Wrap" Text="GITHUB: DANIELGAOR" Width="708" FontFamily="Arial Black" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Top" Visibility="Hidden"/>
        <Button x:Name="btnVolverAlJuego" Content="VOLVER AL JUEGO" Height="21" Margin="0,56,0,0" VerticalAlignment="Top" Width="150" Click="Boton_VolverAljuego" FontFamily="Impact" FontSize="15" Background="#FFE6E6E6" BorderBrush="Black" HorizontalAlignment="Center" Visibility="Hidden"/>

    </Grid>
</Window>
